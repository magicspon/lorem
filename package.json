{
  "name": "lorem-click-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter lorem-click dev",
    "dev:portless": "pnpm --filter lorem-click dev:portless",
    "build": "pnpm --filter lorem-click build",
    "start": "pnpm --filter lorem-click start",
    "test": "vitest run",
    "test:unit": "turbo run test:unit",
    "test:component": "turbo run test:component",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "oxfmt && oxlint --fix",
    "spell-check": "cspell .",
    "spell-check:sort": "node scripts/sort-cspell-words.mjs",
    "check": "oxfmt --check && oxlint",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "clean": "pnpm -r --parallel clean && rm -rf node_modules .turbo coverage .fallow",
    "storybook:ui": "pnpm --filter @repo/ui storybook",
    "changeset:check": "node scripts/check-changesets.mjs",
    "release": "changeset publish",
    "version-packages": "changeset version && pnpm install --lockfile-only && oxfmt",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@repo/config": "workspace:*",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "cspell": "^10.5.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "tsx": "^4.23.15",
    "turbo": "2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
