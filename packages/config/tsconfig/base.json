{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    // DOM for `Request`/`Response`/`Headers`/`URL`: the handler seam is the
    // platform-neutral pair, and `core` is meant to run in a browser (a
    // Storybook decorator, an MSW worker) as readily as in Node.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    // `#/*` imports name their extension: `imports` in package.json is the one
    // alias TypeScript, Vite and Node all resolve, and it does not probe for one.
    "allowImportingTsExtensions": true,

    "strict": true,
    /**
     * On because the source already assumes it. Guards like `const [, target] =
     * key.split(" "); if (target === undefined)` are correct at runtime and
     * unreachable to the typechecker without this — which the type-aware lint
     * reports as a redundant condition, i.e. it would have us delete the check
     * that makes a malformed registry key throw instead of silently parsing.
     */
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true
  }
}
