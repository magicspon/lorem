{
  "extends": "@repo/config/tsconfig/library.json",

  /**
   * The tooling files, and only those. Package source is checked by each
   * package's own tsconfig, via `pnpm -r typecheck`.
   */
  "include": [
    "packages/*/vitest.config.ts",
    "packages/*/vitest.setup.ts",
    "apps/*/vitest.config.ts",
    "vitest.config.ts"
  ]
}
